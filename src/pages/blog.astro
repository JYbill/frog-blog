---
import fs from "fs/promises";
import path from "path";
import { getCollection } from "astro:content";
import MainLayout from "@/layouts/MainLayout.astro";
import BlogPostWithSearch from "@/components/BlogPostWithSearch";
import type { BlogType } from "@/types/blog";

const blogCollectionEntries = await getCollection("blogs");
const blogs: BlogType[] = [];
for (const blog of blogCollectionEntries) {
  const filePath = blog.filePath as string;
  const stats = await fs.stat(filePath);
  const ext = path.extname(filePath);
  blogs.push({
    title: path.basename(filePath, ext),
    id: blog.id,
    desc: blog.data.description,
    modifyTime: stats.mtimeMs,
  });
}
const sortBlogs = blogs.sort((a, b) => b.modifyTime - a.modifyTime);
---

<MainLayout title="Blog">
  <div class="flex flex-col items-start justify-center max-w-2xl mx-auto mb-16">
    <h1 class="mb-4 text-3xl font-bold tracking-tight text-black md:text-5xl dark:text-white" transition:name="title">
      Blog
    </h1>
    <p class="mb-4 text-gray-600 dark:text-gray-400">
      I write a variety of tech blogs in my daily life, There are
      <strong>{sortBlogs.length}</strong>
      articles in total. Use the search below to filter by title.
    </p>
    <BlogPostWithSearch client:only="react" sortBlogs={sortBlogs} />
  </div>
</MainLayout>
