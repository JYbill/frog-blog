---
import type { InferGetStaticPropsType, GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import MainLayout from "@/layouts/MainLayout.astro";
import { Picture } from "astro:assets";
import readingTime from "reading-time/lib/reading-time.js";
import BlogPostViews from "@/components/BlogPostViews";
import { HomeConfig } from "@/config";
import { getTitleByPath } from "@/lib/node.runtime";
import { stat } from "node:fs/promises";
import { unifyDate } from "@/lib/ecma.util";

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

export const getStaticPaths = (async () => {
  const blogsEntries = await getCollection("blogs");
  return blogsEntries.map((blog) => {
    const filePath = blog.filePath as string;
    const title = getTitleByPath(filePath);
    return {
      params: { id: blog.id },
      props: { blog, title, filePath },
    };
  });
}) satisfies GetStaticPaths;

const { blog, title, filePath } = Astro.props as Props;

// 更新时间
const { mtimeMs } = await stat(filePath);
const modifyDate = new Date(mtimeMs);
const date = unifyDate(modifyDate);

// 阅读时间
const readTime = readingTime(blog.body as string).text;

// MD渲染内容
const { Content } = await render(blog);
---

<MainLayout title={title} description={blog.data.description} ogImage={Astro.site + "og.png"}>
  <article class="flex flex-col items-start justify-center w-full max-w-2xl mx-auto mb-16">
    <h1 class="mb-4 text-3xl font-bold tracking-tight text-black md:text-5xl dark:text-white" transition:name="fade">
      {title}
    </h1>
    <div class="flex flex-col items-start justify-between w-full mt-2 md:flex-row md:items-center">
      <div class="flex items-center">
        <Picture src={HomeConfig.avatar} class="rounded-full h-6 w-6" alt="Dedsec" formats={["avif", "webp"]} />
        <p class="ml-2 text-sm text-gray-700 dark:text-gray-300">
          {`${HomeConfig.authorName} / ${date}`}
        </p>
      </div>
      <p class="mt-2 text-sm text-gray-600 dark:text-gray-400 min-w-32 md:mt-0">
        {readTime}
        {` • `}
        <BlogPostViews client:only="react" />
      </p>
    </div>
    <div class="w-full mt-4 prose dark:prose-dark max-w-none break-words">
      <h2>Description</h2>
      <p>{blog.data.description}</p>
      <Content />
      <giscus-wrapper>
        <giscus-widget
          id="comments"
          repo="JYbill/disscusion-blog"
          repoid="R_kgDONsAssQ"
          category="Announcements"
          categoryid="DIC_kwDONsAssc4CmISc"
          mapping="pathname"
          term="Welcome to giscus!"
          reactionsenabled="1"
          emitmetadata="0"
          inputposition="top"
          theme="preferred_color_scheme"
          lang="zh-CN"
          loading="lazy"
          strict="1"></giscus-widget>
      </giscus-wrapper>
    </div>
  </article>
</MainLayout>
<script>
  import "https://cdn.jsdelivr.net/npm/giscus@1.6.0/+esm";
  import { theme, Theme } from "@/store/theme";
  import type { GiscusWidget } from "giscus";

  // 自定义元素，为giscus-widget设置初始化属性
  class GiscusWrapper extends HTMLElement {
    connectedCallback() {
      const giscusWidget = document.getElementById("comments") as GiscusWidget;
      giscusWidget.theme = theme.get();
    }
  }
  customElements.define("giscus-wrapper", GiscusWrapper);

  // 监听theme变化
  theme.subscribe((themeValue: Theme) => {
    const giscusWidget = document.getElementById("comments") as GiscusWidget;
    if (giscusWidget) {
      giscusWidget.theme = themeValue;
    }
  });
</script>
